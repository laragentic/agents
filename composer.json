{
  "name": "laragentic/agents",
  "description": "Agentic loops and AI agent capabilities for the Laravel AI SDK",
  "keywords": [
    "laravel",
    "ai",
    "agents",
    "react",
    "agentic",
    "loops"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Dale Hurley"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/ai": "^0.1.5",
    "illuminate/contracts": "^12.0",
    "illuminate/support": "^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Laragentic\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Laragentic\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Laragentic\\LaragenticServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "test-coverage": "pest --coverage"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
